REM  cpm.bat
REM	Create a new CPM.OUT file
REM
@echo on
if "%shell" != "4dos" goto ERR
echo .ascii "%_date at %_time" > stamp.s
delay 1
REM command /C C:\gccashware\gcc-m68k-ashware\bin\make all
nmake all
copy /b *.out F:\
@echo Done.
goto EXIT
:ERR
@echo Must use 4DOS.COM to do the 'make'
@echo Exit.
:EXIT
