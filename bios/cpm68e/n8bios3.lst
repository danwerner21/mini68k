  71               	
  72               	
  73               	/*
  74               	  CP/M bios calls [0-22]
  75               	*/
  76               	/************************************************************************
  77               		enter with:
  78               	
  79               			D0.w		call number
  80               			D1.w, D1.l	parameter 1
  81               			D2.w, D2.l	parameter 2
  82               	
  83               		return with:
  84               	
  85               			possible code in D0.b,w,l
  86               	
  87               	************************************************************************/
  88               	bios3_trap_entry:
  89 004c 0C40 0017 		cmp.w	#n_cpm_vectors/4,%d0	
  90 0050 6506      		blo.s	okay
  91 0052 203C 0000 		move.l	#n_cpm_vectors/4,%d0	/* set to 23 -- undefined */
  91      0017 
  92               	okay:
  93 0058 48E7 60C0 		movem.l	%d1-%d2/%a0-%a1,-(%sp)	/* register save */
  94 005c E548      		lsl.w	#2,%d0			/* multiply by 4 */
  95 005e 227B 000E 		move.l	cpm_vector(%pc,%d0.w),%a1
  96               	.if !RETAIL
  97               		lsr.w	#2,%d0			/* restore D0 */
  98               	.endif
  99 0062 4E91      		jsr	(%a1)			/* C-callable routine */
 100 0064 4CDF 0306 		movem.l	(%sp)+,%d1-%d2/%a0-%a1
 101 0068 4E73      		rte				/* return from exception */
 102               	
 103               	undefined:
 104               	.if !RETAIL
 105               		illegal
 106               	.endif
