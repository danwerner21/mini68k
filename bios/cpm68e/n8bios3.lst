  32               	_init:
  33 0000 2C5F      		movea.l	(%sp)+,%a6		/* grab the return address */
  34               	/* clearing the .BSS below will kill the return */
  35               	
  36               		/* any initialization goes here */
  37               	addr_trap3	=   (32+3)*4
  38 0002 21FC 0000 		move.l	#bios3_trap_entry,addr_trap3	/* install CP/M-68 BIOS on trap #3 */
  38      0000 008C 
  39               	
  40               	/* clear the .BSS */
  41 000a 207C 0000 		movea.l	#__bss_start,%a0
  41      0000 
  42 0010 223C 0000 		move.l	#_end,%d1
  42      0000 
  43 0016 9288      		sub.l	%a0,%d1
  44 0018 E489      		lsr.l	#2,%d1
  45 001a 6002      		br.s	zap1
  46 001c 4298      	zap:	clr.l	(%a0)+
  47 001e 51C9 FFFC 	zap1:	dbra	%d1,zap
  48               	
  49               	
  50               	/* first part of the disk system initialization */
  51 0022 4EB9 0000 		jsr	disk_system_init
  51      0000 
  52               	
  53               	/* last part of disk initialization is to set up the RAMdisk */
