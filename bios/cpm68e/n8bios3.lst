  57 002e 207C 0000 		movea.l	#copyright,%a0
  57      0000 
  58 0034 4281      		clr.l	%d1		/* NUL terminator */
  59 0036 7003      		moveq.l	#3,%d0		/* put string call */
  60 0038 4E48      		trap	#8
  61               		
  62 003a 207C 0000 		movea.l	#retrobrew,%a0	/* moved to exceptn.s */
  62      0000 
  63 0040 4281      		clr.l	%d1		/* NUL terminator */
  64 0042 7003      		moveq.l	#3,%d0		/* put string */
  65 0044 4E48      		trap	#8
  66               	
  67 0046 303C 0005 		move.w	#0x0005,%d0	/* set user=0 and disk=5 */
