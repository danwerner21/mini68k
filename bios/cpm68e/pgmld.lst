 148 00ec 0887 0000 	        bclr    #0,%d7           /* make it even address */
 149 00f0 2B87 2800 	        move.l  %d7,0(%a5,%d2)     /* insert address in segment table */
 150 00f4 BEA8 0004 	        cmp.l   LoAdr(%a0),%d7    /* check for conflict with low memory */
 151 00f8 6D00 FFD4 	        blt     confbd
