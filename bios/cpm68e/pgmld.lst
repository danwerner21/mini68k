 128               	trymemtp:
 129               	# entry: %d2 is a segment nmbr [0..4]
 130               	# try to fit it at top of memory
 131               	# uses %d3, %d6, %d7, %a5, %a6
 132               	# returns 0 in %d1 if ok
 133 00d2 2C02      	        move.l  %d2,%d6           /* %d6 is loop counter for chksegs */
