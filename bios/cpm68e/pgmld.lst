 138               	chksegs:
 139               	# entry: %d2 = 4 * (segment nmbr to try)
 140               	#        %d6 = (%d2/4) - 1  (loop counter)
 141               	#        %d7 = address below which to try it
 142               	# check for conflicts with segments [0..%d6] and low memory boundary
 143               	# return 0 in %d1 if no conflicts, else %d1 = 1
 144               	# uses %d3, %a5, %a6
