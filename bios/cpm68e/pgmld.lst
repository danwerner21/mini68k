 404               	reloc:
 405               	# Modify address references of code and data segments based on relocation bits
 406               	# During this routine,
 407               	# %a2 points to text file to relocate
 408               	# %a3 points to relocation word in basepg
 409               	# lsb of %d2 is long word flag (set on reloc type 5, reset on next word)
 410               	# %d3 is # words in relocation buffer
 411               	# %d4 is nmbr of words left to relocate
 412               	# %d5 is relocation offset
 413               	
