  41               	_read_sector:
  42 0000 4E56 0000 		link	%a6,#0
  43 0004 48E7 3000 		movem.l	%d2-%d3,-(%sp)
  44 0008 222E 0008 		move.l	8(%a6),%d1	/* drive */
  45 000c 242E 000C 		move.l	12(%a6),%d2	/* lba */
  46 0010 7601      		move.l	#1,%d3		/* sector count = 1 */
  47 0012 206E 0010 		move.l	16(%a6),%a0	/* memory address */
  48 0016 700C      		move.l	#disk_read,%d0	/* function code */
  49 0018 4E48      		trap	#bios
  50 001a 4CDF 000C 		movem.l	(%sp)+,%d2-%d3
  51 001e 4E5E      		unlk	%a6
  52 0020 4E75      		rts
  53               	
  54               	_write_sector:
  55 0022 4E56 0000 		link	%a6,#0
  56 0026 48E7 3000 		movem.l	%d2-%d3,-(%sp)
  57 002a 222E 0008 		move.l	8(%a6),%d1	/* drive */
  58 002e 242E 000C 		move.l	12(%a6),%d2	/* lba */
  59 0032 7601      		move.l	#1,%d3		/* sector count = 1 */
  60 0034 206E 0010 		move.l	16(%a6),%a0	/* memory address */
  61 0038 700D      		move.l	#disk_write,%d0	/* function code */
  62 003a 4E48      		trap	#bios
  63 003c 4CDF 000C 		movem.l	(%sp)+,%d2-%d3
  64 0040 4E5E      		unlk	%a6
  65 0042 4E75      		rts
  66               	
  67               	_disk_reset:
  68 0044 4E56 0000 		link	%a6,#0
  69 0048 222E 0008 		move.l	8(%a6),%d1	/* drive */
  70 004c 700A      		move.l	#disk_reset,%d0	/* function code */
  71 004e 4E48      		trap	#bios
  72 0050 4E5E      		unlk	%a6
  73 0052 4E75      		rts
  74               	
  75               	_disk_info:
  76 0054 4E56 0000 		link	%a6,#0
  77 0058 222E 0008 		move.l	8(%a6),%d1	/* drive */
  78 005c 206E 000C 		move.l	12(%a6),%a0	/* memory address */
  79 0060 700B      		move.l	#disk_info,%d0	/* function code */
  80 0062 4E48      		trap	#bios
  81 0064 4E5E      		unlk	%a6
  82 0066 4E75      		rts
  83               	
  84               	
  85               	_get_hma:
  86 0068 4281      		clr.l	%d1
  87 006a 6004      		br.s	hma_call
  88               	_halloc:
  89 006c 222F 0004 		move.l	4(%sp),%d1
  90               	hma_call:
  91 0070 7008      		move.l	#hma_alloc,%d0
  92 0072 4E48      		trap	#bios
68K GAS  n8iox.s 			page 4


