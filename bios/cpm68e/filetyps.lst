  28               	
  29               	init_tbl:
  30 0000 23FC 0000 	        move.l  #typ1,typ1p
  30      0000 0000 
  30      0000 
  31 000a 23FC 0000 	        move.l  #typ2,typ2p             /* init the pointers to the filetypes */
  31      0000 0000 
  31      0000 
  32 0014 23FC 0000 	        move.l  #typ3,typ3p
  32      0000 0000 
  32      0000 
  33 001e 23FC 0000 	        move.l  #null,typ4p
  33      0000 0000 
  33      0000 
  34               	
  35 0028 23FC 0000 	        move.l  #load68k,pgld1
  35      0000 0000 
  35      0000 
  36 0032 23FC 0000 	        move.l  #load68k,pgld2         /* init the pointers to the loaders */
  36      0000 0000 
  36      0000 
  37 003c 23FC 0000 	        move.l  #load68k,pgld3
  37      0000 0000 
  37      0000 
  38 0046 23FC 0000 	        move.l  #load68k,pgld4
  38      0000 0000 
  38      0000 
