  44               	#************************************************************************
  45               	#                                                                       /* */
  46               	#                         CP/M-68K LOADER TABLE                         /* */
  47               	#                         =====================                         /* */
  48               	#                                                                       /* */
  49               	#-----------------------------------------------------------------------*
  50               	#                                                                       /* */
  51               	#       STRUCTURE OF A LOADER TABLE ENTRY:                              /* */
  52               	#       =================================                               /* */
  53               	#                                                                       /* */
  54               	#       (1)  LONG WORD pointer to a filetype                            /* */
  55               	#       (2)  LONG WORD address of the program loader for the above type *
  56               	#       (3)  BYTE flag #1                                               /* */
  57               	#       (4)  BYTE flag #2                                               /* */
  58               	#                                                                       /* */
  59               	#************************************************************************
  60               	
  61               	
  62               	load_tbl:
  63 0000 0000 0000 	typ1p:  .ds.l   1
  64 0004 0000 0000 	pgld1:  .ds.l   1
  65 0008 00        	        .ds.b   1
  66 0009 00        	        .ds.b   1
  67 000a 0000 0000 	typ2p:  .ds.l   1
  68 000e 0000 0000 	pgld2:  .ds.l   1
  69 0012 00        	        .ds.b   1
  70 0013 00        	        .ds.b   1
  71 0014 0000 0000 	typ3p:  .ds.l   1
  72 0018 0000 0000 	pgld3:  .ds.l   1
  73 001c 00        	        .ds.b   1
  74 001d 00        	        .ds.b   1
  75 001e 0000 0000 	typ4p:  .ds.l   1
  76 0022 0000 0000 	pgld4:  .ds.l   1
  77 0026 00        	        .ds.b   1
  78 0027 00        	        .ds.b   1
  79               	
  80               	
