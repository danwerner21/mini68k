  82               	init3:	cmpi	#trap2,%d1
  83               		beq	init2		/* don't init trap 2 or trap 3 */
  84               		cmpi	#trap3,%d1
  85               		beq	init2
  86               	.endif
  87 0038 0C41 0030 		cmpi.w	#endvec,%d1
  88 003c 6D00 FFE0 		blt	init1
  89               	#				initialize the exception vector array
  90               	
  91 0040 7012      		moveq.l	#bgetseg,%d0
  92 0042 4E43      		trap	#3		/* get the original TPA limits */
  93 0044 2040      		movea.l	%d0,%a0
  94 0046 4A58      		tst.w	(%a0)+
  95 0048 2218      		move.l	(%a0)+,%d1	/* %d1 = original low TPA limit */
  96 004a 2401      		move.l	%d1,%d2
  97 004c D490      		add.l	(%a0),%d2		/* %d2 = original high TPA limit */
  98 004e 2639 0000 		move.l	tpa_lp,%d3	/* %d3 = new low TPA limit */
  98      0000 
  99 0054 2839 0000 		move.l	tpa_hp,%d4	/* %d4 = new high TPA limit */
  99      0000 
