  58               	# It has 1 passed parameter: the address of the exception vector array
  59 0008 4E56 0000 		link	%a6,#0
  60 000c 48E7 3800 		movem.l	%d2-%d4,-(%sp)
  61               	
  62 0010 7016      		moveq.l	#bsetexc,%d0
