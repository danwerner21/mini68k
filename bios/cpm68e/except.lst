 218               	# jrc .ifdef	M68010
 219               	.if M68000>=68010	/*  jrc  */
 220               	#
 221               	#	Here if the exception in question was a buserr/addressing error.
 222               	#	We reformat the stack to look like a 68000.
 223               	#
 224               	#	Entered with a standard 68010 exception stack frame with a return
 225               	#	address on top (at 0(%sp)).
 226               	#
 227               	berr:
 228               		move.l	0x0(%sp),0x2a(%sp)			/*	Move return address */
 229               		move.w	0x0c(%sp),0x2e(%sp)			/*	Move Status word */
 230               		andi.w	#7,0x2e(%sp)			/*	Clear all but FC0-2 */
 231               		move.l	0x0e(%sp),0x30(%sp)			/*	Copy Fault address */
 232               		move.w	0x1c(%sp),0x34(%sp)			/*	Move IR */
 233               		move.w	0x4(%sp),0x36(%sp)			/*	Move SR */
 234               		move.l	0x6(%sp),0x38(%sp)			/*	Move PC */
 235               		move.w	0x0a(%sp),0x3c(%sp)			/*	Move format word */
 236               		adda.l	#0x2a,%sp				/*	Make %sp -> new frame */
 237               		bra	except				/*	Merge */
 238               	#*****************************************************************************
 239               	#	Here we make up for a faux pas in the C compiler.  Change all        *
 240               	#	move from SR instructions (0x40CX) to move from CCR (0x42CX).          *
 241               	#	Precludes executing 68000 programs in ROM on a 68010.                *
 242               	#                                                                            *
 243               	#	Relies on the fact that the exception PC (Stack offset 0E below)     *
 244               	#	points to the instruction on an illegal instruction exception.       *
 245               	#*****************************************************************************
 246               	privviol:
 247               		movem.l	%d0/%a0,-(%sp)			/*	Save some regs */
 248               		move.l	0x0e(%sp),%a0			/*	%A0 -> Instruction */
 249               		move.w	(%a0),%d0				/*	%d0 =  Instruction */
 250               		andi.w	#0xFFC0,%d0			/*	Mask off <EA> field */
 251               		cmpi.w	#0x40C0,%d0			/*	Move from SR? */
 252               		bne	notsr				/*	No, handle normally */
 253               		ori.w	#0x0200,(%a0)			/*	Change to move from CCR */
 254               		movem.l	(%sp)+,%d0/%a0			/*	Restore regs */
 255               		tst.l	(%sp)+				/*	Pop return address */
 256               		rte					/*	Try it again */
 257               	notsr:	movem.l	(%sp)+,%d0/%a0			/*	Abandon hope, all ye .. */
 258               		.page
 259               	.endif
 260               	except:
 261 0146 4267      		clr.w	-(%sp)
 262 0148 48E7 8080 		movem.l	%a0/%d0,-(%sp)	/* 10 (11) words now on stack in following order */
 263               	#				 _______________________________
 264               	#				|____________%D0.L_______________|
 265               	#				|____________%A0.L_______________|
 266               	#				|____0000______|________________
 267               	#				|_______Handler Return__________|
 268               	#				If bus error, extra 2 longs are here
 269               	#				 ______________
 270               	#				|__Status Reg__|________________
 271               	#				|_____Exception Return__________|
 272               	#				|_(format word)|
 273 014c 202F 000A 		move.l	10(%sp),%d0	/* get return address from above array */
 274 0150 0480 0000 		sub.l	#excrtn0,%d0	/* %d0 now has 4 * (encoded excptn nmbr), where */
68K GAS  exceptn.s 			page 7


 274      0000 
 275               	#				  encoded excptn nmbr is in [0..21,22..37]
 276               	#					      representing  [2..23,32..47]
 277 0156 0C40 0024 		cmpi	#36,%d0		/* if %d0/4 is in [0..9,22..29] then */
 278 015a 6F00 0016 		ble	chkredir	/*     the exception may be redirected */
 279 015e 0C40 0058 		cmpi	#88,%d0
 280 0162 6D00 0028 		blt	dfltexc
 281 0166 0C40 0074 		cmpi	#116,%d0
 282 016a 6E00 0020 		bgt	dfltexc
 283               	#				in range of redirected exceptions
 284 016e 0440 0030 		subi	#48,%d0		/* subtract 4*12 to normalize [0..9,22..29] */
 285               	#							into [0..9,10..17]
 286               	chkredir:
 287 0172 2079 0000 		movea.l	evec_adr,%a0
 287      0000 
 288 0178 D0C0      		adda	%d0,%a0		/* index into exception vector array */
 289 017a 4A90      		tst.l	(%a0)		/* if 00000000, then not redirected */
 290 017c 6600 0064 		bne	usrexc
 291               	#				not redirected, do default handler
 292               	supexc:				/* Here for supervisor state */
 293 0180 0C40 0028 		cmpi	#40,%d0
 294 0184 6D00 0006 		blt	dfltexc
 295 0188 0640 0030 		addi	#48,%d0		/* add 4*12 that was sub'd above */
 296               	dfltexc:
 297 018c DEFC 000E 		adda	#14,%sp		/* throw away 7 words that we added to stack */
 298 0190 E440      		asr	#2,%d0		/* divide %d0 by 4 */
 299               	#				now %d0 is in [0..21,22..37]
 300               	#				to represent [2..23,32..47]
 301 0192 0C40 0002 		cmpi	#2,%d0		/* bus or address error? */
 302 0196 6C00 0006 		bge	nobusexc
 303 019a 4CDF 0300 		movem.l	(%sp)+,%a0-%a1	/* if yes, throw away 4 words from stack */
 304               	nobusexc:
 305 019e 4A5F      		tst.w	(%sp)+		/* throw away stacked SR */
 306 01a0 0640 0002 		addi	#2,%d0
 307 01a4 0C40 0017 		cmpi	#23,%d0		/* get back real excptn nmbr in [2..23,32..47] */
 308 01a8 6F00 0006 		ble	lowexc
 309 01ac 0640 0008 		addi	#8,%d0
 310 01b0 3F00      	lowexc:	move	%d0,-(%sp)	/* save excptn nmbr */
 311 01b2 41F9 0000 		lea	excmsg1,%a0
 311      0000 
 312 01b8 6100 0098 		bsr	print		/* print default exception message */
 313 01bc 301F      		move	(%sp)+,%d0
 314 01be 6100 00BA 		bsr	prtbyte
 315 01c2 41F9 0000 		lea	excmsg2, %a0
 315      0000 
 316 01c8 6100 0088 		bsr	print
 317 01cc 201F      		move.l	(%sp)+,%d0
 318 01ce 6100 0096 		bsr	prtlong
 319 01d2 41F9 0000 		lea	excmsg3, %a0
 319      0000 
 320 01d8 6100 0078 		bsr	print
 321 01dc 4280      		clr.l	%d0
 322 01de 4E42      		trap	#2		/* warm boot */
 323 01e0 4E73      		rte
 324               	
 325               	usrexc:
 326               	# Call user exception handler
68K GAS  exceptn.s 			page 8


 327               	# make sure exception information is on his stack
 328 01e2 0C40 0008 		cmpi	#8,%d0		/* address or bus error? */
 329 01e6 6D00 002E 		blt	addrexc		/* if yes, skip */
 330 01ea 082F 000D 		btst	#13,14(%sp)	/* exception occured in user state? */
 330      000E 
 331 01f0 6600 FF8E 		bne	supexc		/*sw if no, go to supervisor handler */
 332 01f4 2F50 000A 		move.l	(%a0),10(%sp)	/* put user handler address on our stack */
 333 01f8 4E68      		move.l	%usp,%a0		/* user stack pointer to %a0 */
 334 01fa 212F 0010 		move.l	16(%sp),-(%a0)	/* put exception return on user stack */
 335 01fe 312F 000E 		move.w	14(%sp),-(%a0)	/* put SR on user stack */
 336 0202 4E60      		move.l	%a0,%usp		/* update user stack pointer */
 337 0204 4CDF 0101 		movem.l	(%sp)+,%a0/%d0	/* restore regs */
 338 0208 2F6F 0002 		move.l	2(%sp),8(%sp)	/* move address of user handler to excptn rtn */
 338      0008 
 339               	# jrc .ifdef	M68010
 340               	.if M68000>=68010	/*  jrc  */
 341               		clr.w	12(%sp)		/*sw Clear out the format word */
 342               	.endif
 343 020e 5C4F      		addq	#6,%sp		/* clear junk from stack */
 344 0210 0257 7FFF 		andi	#0x7fff,(%sp)	/* clear trace bit */
 345 0214 4E73      		rte			/* go to user handler */
 346               	addrexc:
 347 0216 082F 000D 		btst	#13,22(%sp)	/* exception occured in user state? */
 347      0016 
 348 021c 6600 FF62 		bne	supexc		/*sw if no, go to supervisor handler */
 349 0220 2F50 000A 		move.l	(%a0),10(%sp)	/* put user handler address on our stack */
 350 0224 4E68      		move.l	%usp,%a0		/* user stack pointer to %a0 */
 351 0226 212F 0018 		move.l	24(%sp),-(%a0)	/* put exception return on user stack */
 352 022a 312F 0016 		move.w	22(%sp),-(%a0)	/* put SR on user stack */
 353 022e 212F 0012 		move.l	18(%sp),-(%a0)	/* put extra 2 longs on user stack */
 354 0232 212F 000E 		move.l	14(%sp),-(%a0)
 355 0236 4E60      		move.l	%a0,%usp		/* update user stack pointer */
 356 0238 4CDF 0101 		movem.l	(%sp)+,%a0/%d0	/* restore regs */
 357 023c 2F6F 0002 		move.l	2(%sp),16(%sp)	/* move address of user handler to excptn rtn */
 357      0010 
 358               	# jrc .ifdef	M68010
 359               	.if M68000>=68010	/*  jrc  */
 360               		clr.w	20(%sp)		/*sw Clear format word */
 361               	.endif
 362 0242 DEFC 000E 		adda	#14,%sp		/* clear junk from stack */
 363 0246 0257 7FFF 		andi	#0x7fff,(%sp)	/* clear trace bit */
 364 024a 4E73      		rte			/* go to user handler */
