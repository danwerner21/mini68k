 367               	#******************************************************************************
 368               	#
 369               	#	gouser routine.  This routine performs an RTE to go to the user program
 370               	#			 User EPA is passed in %A0.L.
 371               	#
 372               	#******************************************************************************
 373               	gouser:
 374               	# jrc .ifdef	M68010
 375               	.if M68000>=68010	/*  jrc  */
 376               		clr.w	-(%sp)			/*	Push format word */
 377               	.endif
 378 024c 2F08      		move.l	%a0,-(%sp)		/*	Push epa */
 379 024e 4267      		clr.w	-(%sp)			/*		  and SR */
 380 0250 4E73      		rte				/*	Do it.  Into user program. */
 381               	.page
68K GAS  exceptn.s 			page 10


 382               	#
 383               	#  Subroutines
 384               	#
 385               	
 386               	print:
 387 0252 4281      		clr.l	%d1
 388 0254 1218      		move.b	(%a0)+, %d1
 389 0256 6700 000C 		beq	prtdone
 390 025a 303C 0002 		move	#2, %d0
 391 025e 4E42      		trap	#2
 392 0260 6000 FFF0 		bra	print
 393               	prtdone:
 394 0264 4E75      		rts
 395               	
 396               	prtlong:
 397               	#  Print %d0.l in hex format
 398 0266 3F00      		move	%d0,-(%sp)
 399 0268 4840      		swap	%d0
 400 026a 6100 0004 		bsr	prtword
 401 026e 301F      		move	(%sp)+,%d0
 402               	
 403               	prtword:
 404               	#  Print %d0.w in hex format
