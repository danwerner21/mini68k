  66               	init1:
  67 001e 2601      		move.l	%d1,%d3
  68 0020 E64B      		lsr.w	#3,%d3			/* index into byte array */
  69 0022 0330 3000 		btst.b	%d1,(%a0,%d3.w)		/* skip those marked */
  70 0026 6600 000C 		bne	init2
  71               	
  72 002a 48E7 E000 		movem.l	%d0-%d2,-(%sp)
  73 002e 4E43      		trap	#3		/* BIOS call to set exception vector */
  74 0030 4CDF 0007 		movem.l	(%sp)+,%d0-%d2
  75               	
  76 0034 5281      	init2:	addq.l	#1,%d1
  77 0036 5882      		add.l	#4,%d2
  78               	.if 0
