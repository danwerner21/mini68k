  33               	excmask:
  34               	.if RETAIL
  35 0000 03        		.byte	0b00000011		/*  0..7  */
  36 0001 00        		.byte	0b00000000		/*  8..15 */
  37               	.else
  38               	.if 1	/* for debug, send all to the debugger */
  39               		.byte	0b00010011		/*  0..7  */	/* illegal */
  40               		.byte	0b00000010		/*  8..15 */	/* trace */
  41               	.else
  42               		.byte	0b11111111	/* 0..7 */
  43               		.byte	0b11111111	/* 8..15 */
  44               	.endif
  45               	.endif
  46               	# reserve 8 vectors for the interrupt controller
  47 0002 FF        		.byte	0b11111111		/* 16..23   used by Interrupt Controller */
  48               	# reserve the NMI vector
  49 0003 80        		.byte	0b10000000		/* 24..31   auto vectored interrupts (NMI is 31) */   
  50               	# reserve trap calls 2, 3, & 8
  51 0004 0C        		.byte	0b00001100		/* 32..39   TRAP calls are here */
  52 0005 01        		.byte	0b00000001		/* 40..47   TRAP calls are here*/
  53 0006 00        		.byte	0b00000000		/* 48..55 */
  54 0007 00        		.byte	0b00000000		/* 56..63 */
